# Template for ~/.config/zsh/secrets.zsh
#
# The real file holds API keys / tokens and is NEVER committed (see .gitignore).
# Copy this to ~/.config/zsh/secrets.zsh, fill in real values, then lock it down:
#
#   cp secrets.zsh.example ~/.config/zsh/secrets.zsh
#   chmod 600 ~/.config/zsh/secrets.zsh
#
# It is sourced at the end of ~/.zshrc. Keep it to `export`s only.

# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."
# export GITHUB_TOKEN="..."
# export NPM_TOKEN="..."
